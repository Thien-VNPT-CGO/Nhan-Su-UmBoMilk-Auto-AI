# ===== SERVER =====
PORT=3000
NODE_ENV=development

# PostgreSQL (mọi môi trường). Render/Neon: dán URL do nền tảng cấp vào đây
DATABASE_URL=postgresql://umbomilk:umbomilk123@localhost:5432/umbomilk?schema=public

# Redis (optional - system falls back to Database Persistent Job Queue automatically)
REDIS_URL=

# ===== GOOGLE SHEET =====
GOOGLE_SHEET_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
# Sheet names (must match exactly)
SHEET_NAME_LOC_HO_SO=LOC_HO_SO_PV
SHEET_NAME_DIEM_UV=DIEM_UV
SHEET_NAME_HO_SO_NV=HO_SO_NHAN_VIEN_UNG_TUYEN

# ===== AI =====
# openai | gemini | openai-compatible | mock
AI_PROVIDER=mock
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=

# ===== ZALO =====
ZALO_OA_ID=
ZALO_APP_ID=
ZALO_APP_SECRET=
ZALO_REDIRECT_URI=http://localhost:3000/api/zalo/oauth-callback
ZALO_ACCESS_TOKEN=
ZALO_REFRESH_TOKEN=XWJ8F1HRSQ9B75KMDiH1

# ===== SECURITY =====
SESSION_SECRET=change-me-in-production

# ===== MONITORING (Sentry - optional) =====
SENTRY_DSN=

# ===== BACKUP TỰ ĐỘNG =====
# Chu kỳ sao lưu (ngày), chạy tự động lúc boot + mỗi chu kỳ. 0 = tắt auto backup
BACKUP_AUTO_DAYS=7
# Folder ID trên Google Drive để upload bản sao lưu (optional - cần service account có quyền)
BACKUP_DRIVE_FOLDER=

# ===== THÔNG BÁO NGOÀI (Telegram/Slack - optional) =====
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SLACK_WEBHOOK_URL=

# ===== SYSTEM =====
TIMEZONE=Asia/Ho_Chi_Minh
DEMO_MODE=true

# ===== WEBHOOK SECRET (Google Apps Script / Zalo callbacks) =====
WEBHOOK_SECRET=change-me-webhook-secret

# ===== CLIENT =====
VITE_API_URL=http://localhost:3000