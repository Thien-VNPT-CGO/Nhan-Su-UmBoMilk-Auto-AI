# ===== SERVER =====
PORT=3000
NODE_ENV=development

# SQLite local dev (default) | PostgreSQL production: postgresql://user:pass@host:5432/db
DATABASE_URL=file:./dev.db

# Redis (optional - system falls back to Database Persistent Job Queue automatically)
REDIS_URL=

# ===== GOOGLE SHEET =====
GOOGLE_SHEET_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
# Sheet names (must match exactly)
SHEET_NAME_LOC_HO_SO=LOC_HO_SO_PV
SHEET_NAME_DIEM_UV=DIEM_UV
SHEET_NAME_HO_SO_NV=HO_SO_NHAN_VIEN_UNG_TUYEN

# ===== AI =====
# openai | gemini | openai-compatible | mock
AI_PROVIDER=mock
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=

# ===== ZALO =====
ZALO_OA_ID=
ZALO_ACCESS_TOKEN=
ZALO_REFRESH_TOKEN=

# ===== SECURITY =====
SESSION_SECRET=change-me-in-production

# ===== SYSTEM =====
TIMEZONE=Asia/Ho_Chi_Minh
DEMO_MODE=true

# ===== WEBHOOK SECRET (Google Apps Script / Zalo callbacks) =====
WEBHOOK_SECRET=change-me-webhook-secret

# ===== CLIENT =====
VITE_API_URL=http://localhost:3000