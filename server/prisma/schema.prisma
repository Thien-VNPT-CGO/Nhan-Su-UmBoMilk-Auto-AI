// UMBO MILK - AI Recruitment & Training System
// PostgreSQL (production) / SQLite (dev) - no enums (SQLite compatible)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               String    @id @default(cuid())
  username         String    @unique
  password         String
  fullName         String
  role             String    @default("HR") // ADMIN | HR | VIEWER
  active           Boolean   @default(true)
  twoFactorSecret  String?   // TOTP secret (2FA)
  twoFactorEnabled Boolean   @default(false)
  branchScope      Json?     // string[] — chi nhánh được phép xem (null/[] = tất cả)
  allowedTabs      Json?     // string[] — các tab được phép truy cập bổ sung (cho HR). null/[] = default
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  sessions         Session[]
}

model Session {
  id        String   @id
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  expiresAt DateTime
  ip        String?
  userAgent String?
}

model AuditLog {
  id        String   @id
  user      String
  action    String
  entity    String
  entityId  String
  oldValue  String?
  newValue  String?
  version   Int?
  time      DateTime @default(now())
  ip        String?
  syncJobId String?

  @@index([entityId])
  @@index([time])
}

model Candidate {
  id         String   @id // UV-YYYYMMDD-NNNNN
  thoiGian   DateTime
  tenUv      String
  gioiTinh   String? // Nam | Nữ (từ Google Form)
  namSinh    String
  trinhDo    String
  queQuan    String
  sdtZalo    String
  zaloUserId String? // Mã định danh Zalo (appuser_id) của ứng viên — bắt buộc để gửi tin OA, tự lưu từ webhook/tra cứu theo SĐT
  caLam      String
  chiNhanh   String
  kinhNghiem String
  xuLy       String
  linkFb     String
  kenhBietTin String? // Kênh biết tin ứng tuyển: "Bạn Bè, Người quen giới thiệu" / quảng cáo...

  aiScore          Json? // breakdown D_* / P_*
  tongDiem         Int?
  xepLoai          String? // DAT (7) | GIOI (8) | XUAT_SAC (>=9)
  aiRecommendation String? // PASS | FAIL
  aiNote           String?
  aiConfidence     Float?
  aiScoredAt       DateTime?

  hrDecision   String? // PASS | FAIL | REVIEW
  hrUser       String?
  hrReason     String?
  hrDecisionAt DateTime?

  phongVanAt  DateTime? // Thời gian phỏng vấn (HR nhập khi chấm PASS, tự gửi Zalo cho ứng viên)
  ggMeetLink  String?   // Link Google Meet phỏng vấn online
  calendarEventId String? // Id sự kiện đã tạo trên Google Calendar (nếu dùng auto-create Meet)
  interviewStatus String? // CHUA_PV | DA_PV | QUA_PV | TRUOT_PV | VANG

  ngayBatDauTraining DateTime?
  trangThaiTraining  String? // CHUA_THAM_GIA | SAP_BAT_DAU | BAT_DAU | HOAN_THANH | KHONG_DU_NGAY | LOAI
  soNgayDaTraining   Int       @default(0)

  dataVersion Int      @default(1)
  dataHash    String?
  updatedAt   DateTime @updatedAt
  updatedBy   String?
  source      String   @default("GOOGLE_FORM")

  shifts           Shift[]
  syncJobs         SyncJob[]
  attendanceEvents AttendanceEvent[]
  conflicts        Conflict[]
  zaloMessages     ZaloMessage[]
  quizAttempts     QuizAttempt[]
  employeeKeys     EmployeeKey[]
  deviceResetTickets DeviceResetTicket[]
  leaveRequestTickets LeaveRequestTicket[]

  @@index([chiNhanh])
  @@index([sdtZalo])
  @@index([zaloUserId])
  @@index([thoiGian])
}

model SyncJob {
  id             String     @id // SYNC-000001
  entity         String
  entityId       String
  operation      String // CREATE | UPDATE | UPSERT
  field          String?
  oldValue       String?
  newValue       String? // JSON snapshot
  version        Int
  status         String     @default("PENDING") // PENDING | PROCESSING | SYNCED | RETRY | FAILED | CONFLICT
  retryCount     Int        @default(0)
  nextAttemptAt  DateTime?
  lastError      String?
  idempotencyKey String     @unique
  candidateId    String?
  candidate      Candidate? @relation(fields: [candidateId], references: [id], onDelete: SetNull)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  @@index([status, nextAttemptAt])
  @@index([candidateId])
  @@index([createdAt])
  @@index([entityId, operation])
}

model AttendanceEvent {
  id          String    @id
  candidateId String
  candidate   Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  date        String // yyyy-MM-dd
  shift       String // SANG | CHIEU | TOI
  checkinAt   DateTime
  checkoutAt  DateTime?
  eventType   String    @default("CHECK_IN") // CHECK_IN | COMPLETED
  method      String // ZALO | MANUAL | SYSTEM
  valid       Boolean
  reason      String?
  lateReason  String?   // Lý do đi trễ do nhân viên nhập
  lat         Float?
  lng         Float?
  trainingDay Int?
  createdAt   DateTime  @default(now())

  @@unique([candidateId, date, shift])
  @@index([date])
}

model Shift {
  id          String    @id
  candidateId String
  candidate   Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  date        String // yyyy-MM-dd
  shifts      String // SANG|CHIEU|TOI|OFF
  note        String?
  updatedBy   String?
  dataVersion Int       @default(1)
  updatedAt   DateTime  @updatedAt

  @@unique([candidateId, date])
  @@index([date])
}

model ZaloMessage {
  id          String     @id
  candidateId String?
  phone       String
  content     String
  status      String     @default("PENDING") // PENDING | SENT | FAILED
  error       String?
  provider    String     @default("MOCK")
  direction   String     @default("OUT") // OUT (gửi đi) | IN (nhận từ Zalo)
  messageType String     @default("text") // text | location
  lat         Float?
  lng         Float?
  createdAt   DateTime   @default(now())
  candidate   Candidate? @relation(fields: [candidateId], references: [id], onDelete: SetNull)

  @@index([phone])
  @@index([candidateId])
}

model WebhookEvent {
  id          String    @id
  source      String // GOOGLE_SHEET | ZALO
  payload     Json
  processed   Boolean   @default(false)
  error       String?
  createdAt   DateTime  @default(now())
  processedAt DateTime?
}

model SystemSetting {
  key       String   @id
  value     Json
  updatedBy String?
  updatedAt DateTime @updatedAt
}

model IdempotencyKey {
  key       String   @id
  response  String?
  createdAt DateTime @default(now())
  expiresAt DateTime
}

model Conflict {
  id           String     @id
  entity       String
  entityId     String
  field        String
  webValue     String?
  sheetValue   String?
  webVersion   Int
  sheetVersion Int?
  status       String     @default("OPEN") // OPEN | RESOLVED_WEB | RESOLVED_SHEET
  resolvedBy   String?
  resolvedAt   DateTime?
  createdAt    DateTime   @default(now())
  candidate    Candidate? @relation(fields: [entityId], references: [id], onDelete: Cascade)

  @@index([entityId, status])
}

model ApiLog {
  id         String   @id
  method     String
  path       String
  status     Int
  durationMs Int
  ip         String?
  user       String?
  createdAt  DateTime @default(now())
}

model ReconciliationRun {
  id         String    @id
  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  checked    Int       @default(0)
  mismatches Int       @default(0)
  repaired   Int       @default(0)
  conflicts  Int       @default(0)
  status     String    @default("RUNNING")
  details    String?
}

model Notification {
  id        String   @id
  userId    String? // null = gửi cho tất cả (hoặc theo role)
  role      String? // ADMIN | HR | VIEWER — lọc thêm khi userId null
  title     String
  body      String
  type      String   @default("INFO") // INFO | SUCCESS | WARNING | ERROR
  link      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, read])
  @@index([createdAt])
}

model Course {
  id          String   @id
  title       String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  lessons     Lesson[]
}

model Lesson {
  id        String        @id
  courseId  String
  course    Course        @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title     String
  content   String
  order     Int           @default(0)
  questions QuizQuestion[]
  attempts  QuizAttempt[]

  @@index([courseId])
}

model QuizQuestion {
  id           String @id
  lessonId     String
  lesson       Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  question     String
  options      Json // string[]
  correctIndex Int
  explanation  String?

  @@index([lessonId])
}

model QuizAttempt {
  id          String    @id
  lessonId    String
  lesson      Lesson    @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  candidateId String?
  candidate   Candidate? @relation(fields: [candidateId], references: [id], onDelete: SetNull)
  score       Int
  total       Int
  passed      Boolean
  answers     Json
  createdAt   DateTime  @default(now())

  @@index([lessonId])
  @@index([candidateId])
}

model BackupRecord {
  id        String   @id
  kind      String   @default("MANUAL") // MANUAL | AUTO
  status    String   @default("OK") // OK | FAILED | RESTORED
  sizeBytes Int
  summary   Json // số dòng mỗi bảng
  note      String? // JSON dump toàn bộ dữ liệu
  error     String?
  driveId   String?
  createdAt DateTime @default(now())

  @@index([createdAt])
}

model ShiftOffReplacement {
  id              String    @id // REP-YYYYMMDD-XXXX
  candidateIdA    String    // Nhân viên xin OFF / được HR đổi OFF
  candidateNameA  String
  chiNhanh        String
  date            String    // yyyy-MM-dd
  shiftCode       String    // SANG | CHIEU | TOI

  replacementId   String?   // Nhân viên B hiện đang được AI chỉ định thay thế
  replacementName String?
  sdtB            String?

  fallbackPool    Json?     // string[] danh sách candidateId khả dĩ còn lại
  rejectedEmpIds  Json?     // string[] danh sách candidateId đã từ chối

  status          String    @default("PENDING_CONFIRM") // PENDING_CONFIRM | ACCEPTED | REJECTED | EXHAUSTED | CANCELLED
  rejectReason    String?
  expiresAt       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([candidateIdA])
  @@index([replacementId])
  @@index([chiNhanh, date])
  @@index([status])
}

model ShiftSwapRequest {
  id               String    @id
  candidateIdA     String
  candidateNameA   String
  sdtA             String
  chiNhanhA        String
  caLamA           String
  dateA            String

  candidateIdB     String
  candidateNameB   String
  sdtB             String
  chiNhanhB        String
  caLamB           String
  dateB            String

  swapType         String    @default("SWAP_2_WAY") // SWAP_2_WAY | COVER_1_WAY
  reason           String
  status           String    @default("PENDING_MANAGER") // PENDING_B | PENDING_MANAGER | APPROVED | REJECTED | CANCELLED
  rejectReason     String?
  approvedBy       String?
  approvedAt       DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([candidateIdA])
  @@index([candidateIdB])
  @@index([status])
}

model EmployeeKey {
  id           String    @id
  key          String    @unique // Mã key kích hoạt (ví dụ: TRN-9821-4412 hoặc EMP-8812-9901)
  candidateId  String
  candidate    Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  type         String    // TRAINING | OFFICIAL
  status       String    @default("ACTIVE") // ACTIVE | EXPIRED | REVOKED
  deviceId     String?   // UUID gán cứng thiết bị duy nhất
  activatedAt  DateTime?
  expiresAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([candidateId])
  @@index([key])
  @@index([deviceId])
}

model DeviceResetTicket {
  id                String    @id
  candidateId       String    // Mã NV yêu cầu reset
  candidate         Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  creatorType       String    @default("EMPLOYEE_SELF") // EMPLOYEE_SELF (TH1: Máy cũ) | STORE_MANAGER_FOR_EMP (TH2: Mất máy)
  createdBy         String    // Mã NV hoặc Username Quản lý tạo phiếu
  reason            String    // Lý do đổi điện thoại (đổi máy mới, bị mất điện thoại, máy bị hỏng...)
  status            String    @default("PENDING_MANAGER") // PENDING_MANAGER | PENDING_IT | APPROVED | REJECTED
  managerUser       String?   // Quản lý cửa hàng xác nhận
  managerApprovedAt DateTime?
  itUser            String?   // IT Admin phê duyệt
  itApprovedAt      DateTime?
  rejectReason      String?   // Lý do từ chối nếu có
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([candidateId])
  @@index([status])
}

model LeaveRequestTicket {
  id            String    @id // LVR-YYYYMMDD-XXXX
  candidateId   String
  candidate     Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  candidateName String
  chiNhanh      String
  date          String    // YYYY-MM-DD
  shiftCode     String    // SANG | CHIEU | TOI
  reason        String
  status        String    @default("PENDING_HR_APPROVAL") // PENDING_HR_APPROVAL | APPROVED | REJECTED
  hrUser        String?
  hrReason      String?
  approvedAt    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([candidateId])
  @@index([status])
  @@index([chiNhanh, date])
}
